{
  "rules": {
    "conductores_activos": {
      ".read": "auth != null",
      "$conductorId": {
        ".write": "auth != null && auth.uid === $conductorId",
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "bearing": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 360"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "lastStatusUpdate": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'disponible' || newData.val() === 'ocupado' || newData.val() === 'on_trip')"
        },
        "isActive": {
          ".validate": "newData.isBoolean()"
        },
        "driverId": {
          ".validate": "newData.val() === $conductorId"
        },
        "currentRideId": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && root.child('rideRequests').child(newData.val()).exists())"
        }
      }
    },
    "driverNotifications": {
      "$driverId": {
        ".read": "auth != null && auth.uid === $driverId",
        ".write": false,
        "$notificationId": {
          ".validate": "newData.hasChildren(['type', 'rideId', 'createdAt']) && newData.child('type').isString() && newData.child('rideId').isString() && (newData.child('read').val() === false || newData.child('read').val() === true || !newData.child('read').exists())"
        }
      }
    },
    "rideRequests": {
      ".indexOn": [
        "status"
      ],
      "$rideId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || data.child('driverId').val() === auth.uid)",
        ".write": false
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
